class OkdeskAPI:
    """Main Okdesk API client class.

    Automatically initializes all API sections as attributes.
    Handles authentication and request execution.
    """

    api_token: str | None = None
    base_url: str | None = None

    def __init__(
            self, account: str, login: str, password: str
    ):
        """
        :param account: Company account (subdomain)
        :param login: User login
        :param password: User password
        """
        {# Initialize all API sections #}
        {%- for section in sections -%}
        self.{{ section.aggregator_attr_name }} = {{ section.class_name }}(self)
        {% endfor %}

        self.base_url = f'{{ base_url }}'
        self._get_api_token(login, password)

    def _get_api_token(
            self, login: str, password: str
    ) -> None:
        """Get API token using login and password."""
        param = {"login": login, "password": password}
        response = self._send_request("POST", "/api/v1/users/sign_in", param)
        self.api_token = response["api_key"]

    def _send_request(
            self, method: str, endpoint: str, params: dict = {}
    ) -> dict:
        """
        Base method for executing API requests.

        :param method: HTTP method (GET, POST, etc.)
        :param endpoint: API endpoint
        :param params: Request parameters
        :return: API response in JSON format
        :raises NotCorrectAnswer: On API errors
        """
        url = f"{self.base_url}/{endpoint}"
        params["api_token"] = self.api_token
        headers = {"Content-Type": "application/json"}

        with requests.Session() as session:
            response = session.request(
                method=method, url=url, headers=headers, params=params
            )
        response_data = response.json()

        # Check for HTTP errors and business logic errors
        if (
            response.status_code < 200
            or response.status_code > 299
            or "errors" in response_data
        ):
            raise NotCorrectAnswer(response_data, response.status_code)
        return response_data
